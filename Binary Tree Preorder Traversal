class Solution {

    List<Integer> ans = new ArrayList<>();

    public List<Integer> preorderTraversal(TreeNode root) {

        preorder(root);

        return ans;
    }

    public void preorder(TreeNode node) {

        if (node == null)
            return;

        // Root
        ans.add(node.val);

        // Left
        preorder(node.left);

        // Right
        preorder(node.right);
    }
}
