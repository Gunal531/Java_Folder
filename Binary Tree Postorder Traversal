class Solution {

    List<Integer> ans = new ArrayList<>();

    public List<Integer> postorderTraversal(TreeNode root) {

        postorder(root);

        return ans;
    }

    public void postorder(TreeNode node) {

        if (node == null)
            return;

        // Left
        postorder(node.left);

        // Right
        postorder(node.right);

        // Root
        ans.add(node.val);
    }
}
